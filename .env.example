# ── Credenziali API ──
FACTUM_API_URL=https://api.factum.pyragogy.org
FACTUM_API_KEY=your_factum_api_key_here

# ── Fatture in Cloud v2 ──
FIC_BASE_URL=https://api-v2.fattureincloud.it
FIC_API_KEY=your_fic_personal_access_token_here
