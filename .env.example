# ── Watcher ──
WATCH_DIR=~/Downloads

# ── Config personalizzata (opzionale) ──
CONFIG_FILE=config.yaml
# ── Cartelle fatture (italiano, create automaticamente) ──
INBOX_DIR=./da_elaborare
PROCESSED_DIR=./elaborate
FAILED_DIR=./errori
